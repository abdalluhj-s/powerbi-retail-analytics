// =============================================================================
//               DAX MEASURES & CALCULATED TABLES FOR GRADUATION PROJECT
//               Project: Global Retail & E-Commerce Executive Analytics
// =============================================================================

/* 
   NOTE: Best Practice in Power BI:
   1. Create an empty table named `_Measures` to store all your business metrics.
   2. Mark `Dim_Date` as a Date Table (Table Tools > Mark as Date Table).
   3. Format all currencies with `$` and 2 decimals or thousands separator.
   4. Format percentages as `0.0%`.
*/

// =============================================================================
// 1. DATE TABLE GENERATION (CALCULATED TABLE)
// =============================================================================
// In Power BI Desktop: Modeling tab -> New Table -> Paste this code:

Dim_Date = 
VAR MinYear = YEAR(MIN(Fact_Sales[OrderDate]))
VAR MaxYear = YEAR(MAX(Fact_Sales[OrderDate]))
RETURN
ADDCOLUMNS(
    CALENDAR(DATE(MinYear, 1, 1), DATE(MaxYear, 12, 31)),
    "Year", YEAR([Date]),
    "Quarter", "Q" & FORMAT([Date], "Q"),
    "Quarter Year", "Q" & FORMAT([Date], "Q") & "-" & YEAR([Date]),
    "Month Number", MONTH([Date]),
    "Month Name", FORMAT([Date], "mmmm"),
    "Month Short", FORMAT([Date], "mmm"),
    "Year Month Sort", YEAR([Date]) * 100 + MONTH([Date]),
    "Month Year", FORMAT([Date], "mmm yyyy"),
    "Day Number", DAY([Date]),
    "Day of Week Number", WEEKDAY([Date], 2), -- 1: Monday, 7: Sunday
    "Day Name", FORMAT([Date], "dddd"),
    "Day Short", FORMAT([Date], "ddd"),
    "Is Weekend", IF(WEEKDAY([Date], 2) IN {6, 7}, "Weekend", "Weekday")
)


// =============================================================================
// 2. CORE FINANCIAL & OPERATIONAL KPIS
// =============================================================================

// [01] Total Sales
Total Sales = 
SUM(Fact_Sales[TotalSales])

// [02] Total Cost
Total Cost = 
SUM(Fact_Sales[TotalCost])

// [03] Total Profit
Total Profit = 
[Total Sales] - [Total Cost]

// [04] Profit Margin Percentage
Profit Margin % = 
DIVIDE(
    [Total Profit], 
    [Total Sales], 
    0
)

// [05] Total Orders
Total Orders = 
DISTINCTCOUNT(Fact_Sales[OrderID])

// [06] Total Units Sold (Volume)
Total Units Sold = 
SUM(Fact_Sales[Quantity])

// [07] Total Unique Customers
Total Customers = 
DISTINCTCOUNT(Fact_Sales[CustomerID])

// [08] Average Order Value (AOV)
Average Order Value = 
DIVIDE(
    [Total Sales], 
    [Total Orders], 
    0
)

// [09] Average Basket Size (Units per Order)
Average Units Per Order = 
DIVIDE(
    [Total Units Sold], 
    [Total Orders], 
    0
)

// [10] Average Discount Rate
Average Discount % = 
AVERAGE(Fact_Sales[Discount])


// =============================================================================
// 3. TIME INTELLIGENCE & COMPARATIVE ANALYTICS
// =============================================================================

// [11] Year-to-Date (YTD) Sales
Sales YTD = 
TOTALYTD(
    [Total Sales], 
    Dim_Date[Date]
)

// [12] Month-to-Date (MTD) Sales
Sales MTD = 
TOTALMTD(
    [Total Sales], 
    Dim_Date[Date]
)

// [13] Quarter-to-Date (QTD) Sales
Sales QTD = 
TOTALQTD(
    [Total Sales], 
    Dim_Date[Date]
)

// [14] Prior Year Sales (Same Period Last Year)
Sales Prior Year (PY) = 
CALCULATE(
    [Total Sales],
    SAMEPERIODLASTYEAR(Dim_Date[Date])
)

// [15] Year-over-Year (YoY) Sales Variance
YoY Sales Growth = 
VAR CurrentSales = [Total Sales]
VAR PrevSales = [Sales Prior Year (PY)]
RETURN
IF(
    ISBLANK(PrevSales), 
    BLANK(), 
    CurrentSales - PrevSales
)

// [16] Year-over-Year (YoY) Sales Growth Percentage
YoY Sales Growth % = 
DIVIDE(
    [YoY Sales Growth],
    [Sales Prior Year (PY)],
    0
)

// [17] Prior Year Profit
Profit Prior Year (PY) = 
CALCULATE(
    [Total Profit],
    SAMEPERIODLASTYEAR(Dim_Date[Date])
)

// [18] YoY Profit Growth Percentage
YoY Profit Growth % = 
VAR CurrentProfit = [Total Profit]
VAR PrevProfit = [Profit Prior Year (PY)]
RETURN
DIVIDE(
    CurrentProfit - PrevProfit, 
    PrevProfit, 
    0
)


// =============================================================================
// 4. ADVANCED VISUALIZATION & DYNAMIC FORMATTING MEASURES
// =============================================================================

// [19] Dynamic KPI Card Badge (for YoY Status)
YoY Sales Growth Badge = 
VAR GrowthRate = [YoY Sales Growth %]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(GrowthRate), "N/A",
    GrowthRate > 0, "▲ +" & FORMAT(GrowthRate, "0.0%"),
    GrowthRate < 0, "▼ " & FORMAT(GrowthRate, "0.0%"),
    "▬ 0.0%"
)

// [20] Dynamic KPI Color Formatter (Conditional Formatting)
YoY Sales Color = 
VAR GrowthRate = [YoY Sales Growth %]
RETURN
SWITCH(
    TRUE(),
    ISBLANK(GrowthRate), "#808080", // Gray
    GrowthRate >= 0, "#00A86B",    // Corporate Green
    GrowthRate < 0, "#E63946"      // Corporate Red
)

// [21] Profit Health Category
Profit Health Status = 
VAR Margin = [Profit Margin %]
RETURN
SWITCH(
    TRUE(),
    Margin >= 0.35, "High Profitability",
    Margin >= 0.20, "Healthy Margin",
    Margin >= 0.05, "Low Margin",
    "Underperforming / Loss"
)
